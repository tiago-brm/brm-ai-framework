CLIENT_ID=example
BRM_VERSION=dev

ENGINE_PORT=8000
DASHBOARD_PORT=8080
EDITOR_PORT=3000

# Perfil editor: credencial do caderno, no formato usuario:senha.
# Gere uma senha forte (ex.: openssl rand -base64 24) e nao reutilize outras.
SB_USER=

# Perfil backup: chave PUBLICA do age (age-keygen). A privada fica fora do servidor.
BRM_BACKUP_AGE_RECIPIENT=
BACKUP_DIR=./backups
BACKUP_SEGUNDO_DESTINO=

# Perfil remoto
BRM_DOMINIO=

# Segredos do cliente lidos pelo engine (nunca versione o .env)
NOTION_TOKEN=
